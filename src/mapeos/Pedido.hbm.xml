<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "https://hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
	<class name="datos.Pedido" table="Pedido">
    	<id column="idPedido" name="idPedido">
      		<generator class="identity"/>
    	</id>
		
		<property column="fecha" name="fecha" type="java.time.LocalDate"  not-null="true"/>
		
		<many-to-one name="unidad" class="datos.UnidadDeVenta" column="idUnidadDeVenta" not-null="true"/>

		<set name="items" table="ItemPlato" order-by="idItemPlato asc" inverse="true" lazy="true" fetch="select" cascade="all,delete-orphan">
	        <key column="idPedido"/>
	        <one-to-many class="datos.ItemPlato" />
	    </set>
 </class>
</hibernate-mapping>
